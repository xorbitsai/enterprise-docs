#. terminology reviewed.
#: ../../source/troubleshooting/gb10_multinode.rst:32
msgid "Verification"
msgstr "Verifica"

#. Machine-translated prose; technical literals preserved. Navigation and selected
#. terminology reviewed.
#: ../../source/troubleshooting/gb10_multinode.rst:34
msgid ""
"Restart the affected model processes after updating the environment. Confirm the "
"versions on both workers, launch the distributed replica and verify coherent chat "
"output. Retain the image tag and engine logs with the case."
msgstr ""
"Riavviare i processi del modello interessato dopo l'aggiornamento dell'ambiente. "
"Confermare le versioni su entrambi i lavoratori, lanciare la replica distribuita e "
"verificare l'output di chat coerente."

